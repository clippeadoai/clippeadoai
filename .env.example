# Copia este archivo a .env y rellena tus claves. NO lo compartas con nadie.

# Twitch: https://dev.twitch.tv/console/apps  -> Register Your Application
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# TikTok: https://developers.tiktok.com/apps  -> Login Kit + Content Posting API
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Debe ser EXACTAMENTE el mismo redirect URI que registraste en la app de TikTok
TIKTOK_REDIRECT_URI=
# false para apps de TikTok tipo Web (lo normal). true solo si tu app es tipo Desktop.
TIKTOK_USE_PKCE=false
